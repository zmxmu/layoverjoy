{
  "name": "layoverjoy-backend",
  "version": "0.1.0",
  "private": true,
  "description": "LayoverJoy backend API and monitor worker (NestJS + Prisma). LayoverJoy - 转机的乐趣",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "dev": "nest start --watch",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:dev": "prisma migrate dev",
    "seed": "node dist/seed.js",
    "test": "vitest run"
  },
  "prisma": {
    "seed": "node dist/seed.js"
  },
  "dependencies": {
    "@daytona/sdk": "^0.207.0",
    "@fastify/static": "^6.12.0",
    "@nestjs/common": "10.4.15",
    "@nestjs/core": "10.4.15",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/platform-fastify": "10.4.15",
    "@nestjs/swagger": "7.4.2",
    "@prisma/client": "5.22.0",
    "argon2": "0.41.1",
    "ioredis": "5.4.1",
    "nodemailer": "6.9.16",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.9",
    "@nestjs/testing": "10.4.15",
    "@types/node": "20.17.9",
    "@types/nodemailer": "6.4.17",
    "prisma": "5.22.0",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
